# Cấu hình gửi email thông báo khi có khách hàng để lại thông tin (không bắt buộc).
# Nếu bỏ trống, hệ thống vẫn lưu lead vào data/leads.json, chỉ không gửi email thông báo.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email nhận thông báo lead mới. Mặc định dùng SMTP_USER nếu bỏ trống.
LEAD_NOTIFY_EMAIL=sales@pngonesolar.vn

# Mật khẩu đăng nhập trang quản trị xem danh sách khách hàng (/admin/leads) - bắt buộc để
# trang admin hoạt động. Đặt một mật khẩu mạnh, không dùng giá trị mẫu này khi triển khai thật.
ADMIN_PASSWORD=doi-mat-khau-nay
